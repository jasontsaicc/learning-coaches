{
  "suite_name": "cross-coach-governance",
  "evals": [
    {
      "id": 1,
      "name": "active-root-pattern-routing",
      "prompt": "今天沒有 breakpoint，Mistake Registry 有很多 overdue，我們繼續。",
      "expectations": {
        "must_read_active_overlay": true,
        "max_root_patterns_reviewed": 3,
        "must_not_bulk_sweep_registry": true
      }
    },
    {
      "id": 2,
      "name": "wip-limit",
      "prompt": "這條 track 已有三個 active patterns，今天又發現一個不同根因。",
      "expectations": {
        "new_pattern_destination": "backlog",
        "must_preserve_original_mistake": true,
        "must_not_exceed_active_limit": 3
      }
    },
    {
      "id": 3,
      "name": "no-false-l6-update",
      "prompt": "學生剛看完範例，在 coach 提示下第一次完成 lab。請收尾。",
      "expectations": {
        "evidence_stage": "acquire",
        "must_not_raise_matrix_from_this_alone": true,
        "must_record_domain_evidence": true
      }
    },
    {
      "id": 4,
      "name": "portfolio-promotion-gate",
      "prompt": "學生完成一篇課堂筆記和一張截圖，想放入 platform-eks。",
      "expectations": {
        "promotion_verdict": "not-ready",
        "must_request_reproducible_steps": true,
        "must_request_objective_verification": true,
        "must_request_tradeoff_and_limitations": true
      }
    },
    {
      "id": 5,
      "name": "isolated-assessment",
      "prompt": "開始正式英文 mock；學生第一題卡住，請繼續。",
      "expectations": {
        "must_preserve_assessment_isolation": true,
        "must_not_teach_during_mock": true,
        "debrief_timing": "after-assessment"
      }
    },
    {
      "id": 6,
      "name": "terraform-platform-integration",
      "prompt": "Terraform senior fast path 的 module 已通過測試，決定 portfolio 落點。",
      "expectations": {
        "workspace_before_promotion": "workspaces/terraform",
        "flagship_destination": "portfolio/platform-eks/terraform",
        "must_not_create_parallel_portfolio": true
      }
    },
    {
      "id": 7,
      "name": "short-sitting-new-tool",
      "prompt": "只有 20 分鐘，RBAC auth can-i 還沒教，舊卡很多。今天想學怎麼查 403。",
      "expectations": {
        "must_teach_tool_before_assembly": true,
        "must_use_diagram_and_worked_example": true,
        "must_not_bulk_sweep_registry": true,
        "must_save_one_small_unit": true
      }
    },
    {
      "id": 8,
      "name": "superseded-plan",
      "prompt": "SD coaching-brief 要三連過才上新課；curriculum-plan 2026-07-18 明確取消，2026-08-11 要新題先教。今天繼續新題。",
      "expectations": {
        "must_apply_latest_explicit_decision": true,
        "must_not_require_three_consecutive_passes": true,
        "must_not_assume_only_output_gap": true
      }
    },
    {
      "id": 9,
      "name": "cancelled-story-mining",
      "prompt": "K8s curriculum-plan 2026-08-11 已停 story mining，progress 卻說連十三堂未挖；請安排今天。",
      "expectations": {
        "must_not_schedule_cancelled_story_mining": true,
        "must_not_count_cancelled_work_as_debt": true,
        "must_preserve_workspace_history_during_development": true
      }
    },
    {
      "id": 10,
      "name": "stop-without-debt",
      "prompt": "今天時間到了，F/G 還没做，先到這裡。",
      "expectations": {
        "must_save_breakpoint_first": true,
        "must_end_without_extra_question": true,
        "must_not_create_mistake_from_stop": true
      }
    },
    {
      "id": 11,
      "name": "bounded-weekly-review",
      "prompt": "現在觸發 Weekly Review，有 74 筆 unresolved、三個 active root patterns，請規劃。",
      "expectations": {
        "max_topics": 3,
        "max_mistake_items": 3,
        "must_not_bulk_sweep_registry": true,
        "must_not_require_all_mistakes_resolved": true,
        "must_include_artifact_audit": true
      }
    },
    {
      "id": 12,
      "name": "stale-readiness-projection",
      "prompt": "能力矩陣日期早於最新的 progress；學生新完成一次提示下實作，問是否達 L6。",
      "expectations": {
        "must_disclose_snapshot_date": true,
        "must_distinguish_acquire_from_independent": true,
        "must_not_assign_job_level_from_script_or_single_lab": true
      }
    }
  ]
}
